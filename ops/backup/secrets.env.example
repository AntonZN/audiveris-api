# Ключи этого сервера. Скопируйте в secrets.env (в git он не попадёт) и впишите.
# Значение — сразу после «=», без пробелов.

# S3-ключ сервисного пользователя Selectel с доступом к бакету из s3.env.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Необязательно ---
# Telegram: при падении придёт сообщение с логом. Бот — @BotFather, chat_id — @userinfobot.
TG_BOT_TOKEN=
TG_CHAT_ID=
# Сторож «бэкап вообще не запустился» (healthchecks.io и совместимые):
# скрипт дёргает URL при успехе и URL/fail при ошибке, молчание = тревога.
HEALTHCHECK_URL=

# Общие настройки бэкапа на этом сервере. Скопируйте в s3.env и chmod 600.
# Файл читает bash: кавычки можно, пробелы вокруг «=» нельзя.

# --- Куда лить ---
# Yandex Object Storage: https://storage.yandexcloud.net, регион ru-central1
# Selectel: https://s3.ru-1.storage.selcloud.ru, регион ru-1, S3_PROVIDER=Selectel
# AWS: эндпоинт пустой, S3_PROVIDER=AWS
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_PROVIDER=Other
S3_BUCKET=my-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Общая папка в бакете для этого сервера (необязательно), например prod-1.
# Итог: <бакет>/<S3_PREFIX>/<проект>/db/..., .../media/...
S3_PREFIX=

# --- Сколько хранить (можно переопределить в projects/<проект>.env) ---
DB_KEEP_DAILY=7              # последних ежедневных дампов каждой базы
DB_KEEP_WEEKLY=4             # недельных (0 — не делать)
DB_KEEP_MONTHLY=6            # месячных (0 — не делать)
MEDIA_KEEP_DELETED_DAYS=30   # сколько дней хранить удалённые и перезаписанные медиафайлы

# --- Уведомления (необязательно) ---
# Telegram: при падении придёт сообщение с логом. Бот — @BotFather, chat_id — @userinfobot.
TG_BOT_TOKEN=
TG_CHAT_ID=
NOTIFY_ON_SUCCESS=0          # 1 — писать и об успехе
# Сторож «бэкап вообще не запустился» (healthchecks.io и совместимые):
# скрипт дёргает URL при успехе и URL/fail при ошибке, молчание = тревога.
HEALTHCHECK_URL=
# Как подписывать этот сервер в уведомлениях (по умолчанию hostname).
# BACKUP_HOST_LABEL=prod-1

# --- Тонкая настройка ---
# Где временно лежит дамп до заливки (нужно место на размер самого большого дампа).
# WORK_DIR=/var/tmp/docker-backup
# RCLONE_IMAGE=rclone/rclone:1.75.2
# Доп. аргументы для docker run с rclone, например если S3 на этом же сервере:
# RCLONE_DOCKER_ARGS="--network host"

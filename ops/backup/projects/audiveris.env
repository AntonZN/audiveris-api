# Проект audiveris-api. Имя файла (audiveris) — это и имя папки проекта в бакете.
# Имена контейнера и тома — те, что даёт docker compose, когда репозиторий лежит
# в папке audiveris-api. Если папка другая, поправьте (backup.sh check подскажет):
#   docker ps --format '{{.Names}}' && docker volume ls

# --- База ---
DB_CONTAINER=audiveris-api-postgres-1
# Только Postgres. Имя базы и пользователь берутся из переменных контейнера
# (POSTGRES_DB, POSTGRES_USER). Задавать, только если надо иначе:
# DB_NAMES="catalog other"  # несколько баз — через пробел
# DB_USER=
# DB_PASSWORD=

# --- Медиа ---
# «имя=/путь/на/хосте» или «имя=docker-том[:/подпапка]».
# Берём только файлы каталога из админки (CATALOG_MEDIA_DIR): ноты, midi, аудио,
# pdf, обложки, фото авторов, иконки, sf2. Остальное в /storage/out — временные
# результаты OMR и архив провалов — не сохраняем.
MEDIA=(
	"catalog=audiveris-api_storage:/out/catalog"
)
# MEDIA_EXCLUDE=("*.tmp" "cache/**")
# Подстраховка: не удалять из зеркала больше N файлов за прогон.
# MEDIA_MAX_DELETE=1000

# Хранение для этого проекта, если нужно не как в s3.env:
# DB_KEEP_DAILY=14
